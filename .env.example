# ─── Strapi CMS Connection ────────────────────────────────────────────────────
# Set these in Vercel → Project Settings → Environment Variables
#
# VITE_STRAPI_URL: Base URL of your Strapi instance (no trailing slash)
# VITE_STRAPI_API_TOKEN: Read-only API token from Strapi Admin → Settings → API Tokens
#
# Leave both blank to run the website with static/mock data (no CMS dependency).
# ──────────────────────────────────────────────────────────────────────────────

VITE_STRAPI_URL=
VITE_STRAPI_API_TOKEN=

# ─── Backend API Connection ───────────────────────────────────────────────────
# Base URL of the backend service handling contact submissions (e.g. http://localhost:5000)
# Leave blank to use local simulated mock submissions.
# ──────────────────────────────────────────────────────────────────────────────

VITE_BACKEND_URL=

